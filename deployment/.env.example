# Copy to deployment/.env (ignored by Git) and change both passwords.
# The backend reads the same file; the bootstrap password also goes into firmware config.json.
IOT_BROKER_HOST=127.0.0.1
IOT_BROKER_PORT=1883
IOT_BROKER_TLS=0
MQTT_BACKEND_PASSWORD=change-me-backend
MQTT_BOOTSTRAP_PASSWORD=change-me-bootstrap
